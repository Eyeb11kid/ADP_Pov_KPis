          <div class="kpi-label">Sales Dollars</div>
          <div class="kpi-desc">All Selling Channels</div>
          <div class="kpi-var m-pva"><span class="fav">▲ +$2.8M</span><span class="m-both"> (+12.4%)</span> vs plan</div>
          <div class="kpi-var m-plan">Plan · September</div>
          <div class="kpi-row m-pva"><span>Plan</span><b>$22.8M</b></div>
          <div class="kpi-row m-pva m-both"><span>YoY</span><b>+14.8%</b></div>
          <div class="kpi-row m-plan m-both"><span>YoY (plan)</span><b>+6.2%</b></div>
        </div>
      </div>
