<!-- Tooltip Container -->
<div class="tip" id="tip"></div>

<script>
// REVENUE SUMMARY: expand / collapse each period column group horizontally (Month open by default)
(function () {
  var tbl = document.getElementById('rev-summary-table');
  if (!tbl) return;
  tbl.querySelectorAll('th.grp[data-grp]').forEach(function (th) {
    var btn = th.querySelector('.grp-tg'), g = th.getAttribute('data-grp'), n = parseInt(th.getAttribute('data-cols'), 10);
    btn.addEventListener('click', function () {
      var open = btn.getAttribute('aria-expanded') !== 'true';
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      tbl.classList.toggle('c' + g, !open);
      th.setAttribute('colspan', open ? n : 1);
    });
  });
})();

// REVENUE SUMMARY: clicking anywhere on a revenue line row opens its GL transaction detail (the link in the title carries the context)
(function () {
  var tbl = document.getElementById('rev-summary-table');
  if (!tbl) return;
  tbl.addEventListener('click', function (e) {
    var row = e.target.closest('tr.row-link');
    if (!row || e.target.closest('a, button') || e.defaultPrevented) return;
    if (window.getSelection && String(window.getSelection())) return; // text selection, not a click
    var a = row.querySelector('a.line-link');
    if (a) a.click();
  });
})();
</script>
<script src="revenue_analysis_2.js"></script>
