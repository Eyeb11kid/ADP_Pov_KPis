    <!-- Headline 5-KPI Strip -->
    <div class="headline-kpi-bar">
      <div class="hkpi-top-row">
        <div class="hkpi-bar-title">
          <span>Revenue Headline Performance · September Close</span>
          <span class="hkpi-bar-badge">RS Revenue</span>
        </div>
      </div>

      <div class="kpis kpis-5" id="headline-kpis" data-cmp="pva" data-fmt="both">
        [1. Processing Revenue]
        <div class="kpi nd" id="hkpi-proc" data-tip="<b>Processing Revenue</b><br>Act: $93,308.1K vs Plan $89,310.0K (+$3,998.1K / +4.5%)<br>YoY: +6.8% (Plan +4.2%)<br>99.9% of Total RS Revenue">
          <div class="kpi-val"><span class="m-pva">$93.3M</span><span class="m-plan">$89.3M</span></div>
          <div class="kpi-label">Processing Revenue</div>
          <div class="kpi-desc">Core K, Simple &amp; Other</div>
          <div class="kpi-var m-pva"><span class="fav">▲ +$4.0M</span><span class="m-both"> (+4.5%)</span> vs plan</div>
          <div class="kpi-var m-plan">Plan · September</div>
          <div class="kpi-row m-pva"><span>Plan</span><b>$89.3M</b></div>
          <div class="kpi-row m-pva m-both"><span>YoY</span><b>+6.8%</b></div>
          <div class="kpi-row m-plan m-both"><span>YoY (plan)</span><b>+4.2%</b></div>
        </div>

        [2. Asset Revenue]
        <div class="kpi nd" id="hkpi-asset" data-tip="<b>Asset-Based Revenue (AUM Basis)</b><br>Act: $22,692.8K vs Plan $22,000.0K (+$692.8K / +3.2%)<br>Driven by market gains (+$1.5M UBV impact)<br>24.3% of total revenue">
          <div class="kpi-val"><span class="m-pva">$22.7M</span><span class="m-plan">$22.0M</span></div>
          <div class="kpi-label">Asset Revenue</div>
          <div class="kpi-desc">AUM Basis (R0010_MGT)</div>
          <div class="kpi-var m-pva"><span class="fav">▲ +$693K</span><span class="m-both"> (+3.2%)</span> vs plan</div>
          <div class="kpi-var m-plan">Plan · September</div>
          <div class="kpi-row m-pva"><span>Plan</span><b>$22.0M</b></div>
          <div class="kpi-row m-pva m-both"><span>YoY</span><b>+7.8%</b></div>
          <div class="kpi-row m-plan m-both"><span>YoY (plan)</span><b>+4.5%</b></div>
        </div>

        [3. Hard Dollar Fees]
        <div class="kpi nd" id="hkpi-fees" data-tip="<b>Hard Dollar Fee Revenue</b><br>Act: $70,615.3K vs Plan $67,310.0K (+$3,305.3K / +4.9%)<br>Participant &amp; Base recordkeeping fees<br>75.6% of total revenue">
          <div class="kpi-val"><span class="m-pva">$70.6M</span><span class="m-plan">$67.3M</span></div>
          <div class="kpi-label">Hard Dollar Fees</div>
          <div class="kpi-desc">Participant &amp; Base Fees</div>
          <div class="kpi-var m-pva"><span class="fav">▲ +$3.3M</span><span class="m-both"> (+4.9%)</span> vs plan</div>
          <div class="kpi-var m-plan">Plan · September</div>
          <div class="kpi-row m-pva"><span>Plan</span><b>$67.3M</b></div>
          <div class="kpi-row m-pva m-both"><span>YoY</span><b>+6.5%</b></div>
          <div class="kpi-row m-plan m-both"><span>YoY (plan)</span><b>+4.1%</b></div>
        </div>

        [4. Period-End AUM]
        <div class="kpi nd" id="hkpi-aum" data-tip="<b>401(k) Assets Under Management</b><br>Period-End AUM: $194,823.3M ($194.8B)<br>YoY Growth: +7.4% ($13.5B AUM expansion)<br>Average AUM: $191.5B">
          <div class="kpi-val"><span class="m-pva">$194.8B</span><span class="m-plan">$188.0B</span></div>
          <div class="kpi-label">Period-End AUM</div>
          <div class="kpi-desc">401(k) Asset Base</div>
          <div class="kpi-var m-pva"><span class="fav">▲ +$6.8B</span><span class="m-both"> (+3.6%)</span> vs plan</div>
          <div class="kpi-var m-plan">Plan · September</div>
          <div class="kpi-row m-pva"><span>Plan AUM</span><b>$188.0B</b></div>
          <div class="kpi-row m-pva m-both"><span>YoY</span><b>+7.4%</b></div>
          <div class="kpi-row m-plan m-both"><span>YoY (plan)</span><b>+3.8%</b></div>
        </div>

        [5. Sales Dollars]
        <div class="kpi nd" id="hkpi-sales" data-tip="<b>Sales Dollars (New Business Bookings)</b><br>Act: $25,666.7K vs Plan $22,840.0K (+$2,826.7K / +12.4%)<br>Direct $14.2M · NAS $4.1M · SBS $3.9M · MAS $2.1M · GES $1.3M">
